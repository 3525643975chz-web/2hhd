<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.meow.assistant">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 核心：向系统申请查看其他应用的权限，解决看不到微信的问题 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="WeaiText"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeowAssistant"> <!-- 注意这里换成原版的主题，如果没有就删掉这一行 -->
        
        <!-- 启动页：改为 WebUIActivity -->
        <activity
            android:name=".WebUIActivity"
            android:exported="true"
            android:windowDisablePreview="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 保留喵喵助手原版的 Activity 和 Service -->
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".RewriteActivity" android:exported="false" />

        <service
            android:name=".MeowAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service android:name=".RewriteTileService" android:exported="true" />
    </application>
</manifest>
